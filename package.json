{
  "name": "@dannstormy/payhooks",
  "version": "0.2.0",
  "description": "Verify, normalize, and reliably process inbound webhooks from African payment providers (Paystack, Flutterwave).",
  "license": "MIT",
  "author": "Daniel Isaac",
  "homepage": "https://github.com/DannStormy/payhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannStormy/payhooks.git"
  },
  "bugs": {
    "url": "https://github.com/DannStormy/payhooks/issues"
  },
  "keywords": [
    "webhooks",
    "webhook-verification",
    "paystack",
    "flutterwave",
    "payments",
    "idempotency",
    "signature-verification",
    "fintech",
    "nodejs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate:fixtures": "node --env-file-if-exists=.env --import tsx tools/validate-fixtures.ts",
    "validate:file": "node --env-file-if-exists=.env --import tsx tools/validate-fixtures.ts",
    "validate:diff": "node --env-file-if-exists=.env --import tsx tools/validate-fixtures.ts --diff-only"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "better-sqlite3": "^11",
    "ioredis": "^5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "ioredis-mock": "^8.13.1",
    "node-sqlite3-wasm": "^0.8.61",
    "tsx": "^4",
    "typescript": "^5"
  }
}
