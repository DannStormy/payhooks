{
  "name": "payhooks",
  "version": "0.1.0",
  "description": "Verify, normalize, and reliably process inbound webhooks from African payment providers (Paystack, Flutterwave).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate:fixtures": "node --import tsx tools/validate-fixtures.ts",
    "validate:file": "node --import tsx tools/validate-fixtures.ts",
    "validate:diff": "node --import tsx tools/validate-fixtures.ts --diff-only"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "ioredis": "^5",
    "better-sqlite3": "^11"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
